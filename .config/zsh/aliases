# colorized man pages
man() {
  env \
    LESS_TERMCAP_md=$(tput bold; tput setaf 4) \
    LESS_TERMCAP_me=$(tput sgr0) \
    LESS_TERMCAP_mb=$(tput blink) \
    LESS_TERMCAP_us=$(tput setaf 2) \
    LESS_TERMCAP_ue=$(tput sgr0) \
    LESS_TERMCAP_so=$(tput smso) \
    LESS_TERMCAP_se=$(tput rmso) \
    PAGER="${commands[less]:-$PAGER}" \
    man "$@"
}

### OS-SPECIFIC ALIASES ###

case "$(uname -s)" in 

  Linux*)
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias rbn='sudo shutdown --reboot now'
    alias sdn='sudo shutdown --poweroff now'

    alias apt-get='sudo apt-get'
    alias apt='sudo apt'
    alias dps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}" -a' 
    ;;

  Darwin*)
    alias ls='ls -G'
    alias grep='grep --color=auto'
    alias rbn='sudo shutdown -h now'
    alias sdn='sudo shutdown -r now'

    alias f='open -a "Finder"'
    alias code='open -a "Visual Studio Code"'
    alias flushdns='dscacheutil -flushcache'
    ;;

  FreeBSD*) 
    ;;
    
  OpenBSD*)
    unset -f man 
    alias sudo='doas' 
    alias rbn='doas shutdown -r now'
    alias sdn='doas shutdown -p now'
    alias watch='gnuwatch'
    ;;

esac

