

# git wrapper for the bare dotfiles repo
dotfiles() { git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"; }

# Commit all changes to tracked dotfiles and push. Usage: dotfiles-push <message>
dotfiles-push() {
    if [ -z "$1" ]; then
        echo "usage: dotfiles-push <commit message>" >&2
        return 1
    fi
    if dotfiles diff --quiet && dotfiles diff --cached --quiet; then
        echo "dotfiles: nothing to commit"
    else
        dotfiles commit -a -m "$1" || return
    fi
    dotfiles push
}

# Check if local changes should be pushed or remote changes should be pulled
dotfiles-check() {
    local cache="$XDG_CACHE_HOME/dotfiles/last-check"
    local interval=86400
    if [ -f "$cache" ] && [ "$(($(date +%s) - $(stat -c %Y "$cache")))" -lt "$interval" ]; then
        return
    fi
    mkdir -p "$(dirname "$cache")"
    touch "$cache"

    # local: unpushed commits?
    if ! dotfiles diff --quiet main origin/main 2>/dev/null; then
        echo "dotfiles: local changes not pushed — run 'dotfiles-push'"
        return
    fi

    # network: upstream ahead?
    dotfiles fetch --quiet 2>/dev/null || return
    if ! dotfiles diff --quiet main origin/main; then
        echo "dotfiles: updates available — run 'dotfiles-pull'"
    fi
}

mkcd() { mkdir $1; cd $1 }

function sornot () {

  local count=$1
  local word=$2

  if [ $count = 1 ]; then 
    echo "$word"
  else 
    echo "$word""s"
  fi 
}

function relative_seconds () {

  local input=$1
  local time_right_now=$(epoch)
  echo $input - $time_right_now | bc -l 

}

function relative_string () {

  # input an epoch timestamp

  if [ "$1" = "" ]; then 
    printf '%s\n' "now"
  else 
    local relsec=$(relative_seconds $1)

    if [ $relsec -le 0 ]; then 
      local prefix=""
      local postfix=" ago"
      local relsec=$(echo "$relsec * -1" | bc -l) # convert to positive
    else 
      local prefix="in "
      local postfix=""
    fi 

    local days=$(scale=0; echo "$relsec/86400" | bc)
    local hours=$(scale=0; echo "($relsec-($days*86400))/3600" | bc)
    local minutes=$(scale=0; echo "($relsec-($days*86400)-($hours*3600))/60" | bc)
    local seconds=$(scale=0; echo "$relsec-($days*86400)-($hours*3600)-($minutes*60)" | bc)

    if [ $days -eq 0 ]; then 
      if [ $hours -eq 0 ]; then 
        if [ $minutes -eq 0 ]; then 
        printf '%s\n' "$prefix$seconds $(sornot $seconds "second")$postfix"
        else
          printf '%s\n' "$prefix$minutes $(sornot $minutes "minute")$postfix"
        fi 
      else   
        printf '%s\n' "$prefix$hours $(sornot $hours "hour")$postfix"
      fi 
    else 
      printf '%s\n' "$prefix$days $(sornot $days "day")$postfix"
    fi 
  fi 
}
