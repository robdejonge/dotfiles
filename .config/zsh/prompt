### SET PROMPT ### 

if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then

  # logged in through ssh
  PROMPT=""
  PROMPT+="%B%F{green}%n@%m%f%b"       # username@hostname, bold, green
  PROMPT+=":"                          # colon, default 
  PROMPT+="%B%F{blue}%~ %f%b"          # abs or home path, bold, blue
  PROMPT+="%# "                        # privileged or not indication, default
else

  # local login
  PROMPT=""
  PROMPT+="%B%F{blue}%~ %f%b"          # abs or home path, bold, blue
  PROMPT+="%# "                        # privileged or not indication, default
fi

case "$(uname -s)" in                  # start prompt with operating system logo
  Linux*)   LOGO_HEX="\U1F427" ;;
  Darwin*)  LOGO_HEX="\UF8FF"  ;;      
  FreeBSD*) LOGO_HEX="\U1F608" ;;
  OpenBSD*) LOGO_HEX="\U1F421" ;;
  *)        LOGO_HEX="" ;;
esac

# Determine active locale based on standard precedence: LC_ALL > LC_CTYPE > LANG
LOCAL_ENV="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"

case "$LOCAL_ENV" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*)
    # $'...' expansion in Zsh safely parses \Uxxxxxx Unicode escapes at runtime
    LOGO="$(eval "print -n \"\$$'LOGO_HEX'\"" 2>/dev/null)"
    ;;
  *)
    LOGO=""
    ;;
esac

PROMPT="${LOGO}${PROMPT}"

