### SET PROMPT ### 

if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then

  # logged in through ssh
  PROMPT=""
  PROMPT+="%B%F{green}%n@%m%f%b"       # username@hostname, bold, green
  PROMPT+=":"                          # colon, default 
  PROMPT+="%B%F{blue}%~ %f%b"          # abs or home path, bold, blue
  PROMPT+="%# "                        # privileged or not indication, default
else

  # local login
  PROMPT=""
  PROMPT+="%B%F{blue}%~ %f%b"          # abs or home path, bold, blue
  PROMPT+="%# "                        # privileged or not indication, default
fi

case "$(uname -s)" in                  # start prompt with operating system logo 
  Linux*)
    LOGO=$'\U1F427' # Penguin
    ;;
  Darwin*)
    LOGO=$''       # Apple logo
    ;;
  FreeBSD*)
    LOGO=$'\U1F479' # Devil
    ;;
  OpenBSD*)
    LOGO=$'\U1F421' # Pufferfish
    ;;
  *)
    LOGO=''         # Default fallback for unknown OS
    ;;
esac

# Perform the UTF-8 safety check once for all OS types
case "${LANG:-} ${LC_ALL:-} ${LC_CTYPE:-}" in
  *UTF-8*|*utf8*)
    PROMPT="$LOGO $PROMPT"
    ;;
  *)
    PROMPT="$ $PROMPT"
    ;;
esac
