### SET PROMPT ### 

if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then

  # logged in through ssh
  PROMPT=""
  PROMPT+="%B%F{green}%n@%m%f%b"       # username@hostname, bold, green
  PROMPT+=":"                          # colon, default 
  PROMPT+="%B%F{blue}%~ %f%b"          # abs or home path, bold, blue
  PROMPT+="%# "                        # privileged or not indication, default
else

  # local login
  PROMPT=""
  PROMPT+="%B%F{blue}%~ %f%b"          # abs or home path, bold, blue
  PROMPT+="%# "                        # privileged or not indication, default
fi

case "$(uname -s)" in                  # start prompt with operating system logo
  Linux*)   LOGO=$'\xf0\x9f\x90\xa7' ;;  # U+1F427
  Darwin*)  LOGO=$'\xef\xa3\xbf'     ;;  # U+F8FF
  FreeBSD*) LOGO=$'\xf0\x9f\x98\x88' ;;  # U+1F608
  OpenBSD*) LOGO=$'\xf0\x9f\x90\xa1' ;;  # U+1F421
  *)        LOGO="" ;;
esac

# Only keep the logo if the locale is UTF-8 (LC_ALL > LC_CTYPE > LANG)
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;;
  *) LOGO="" ;;
esac

PROMPT="${LOGO}${PROMPT}"
